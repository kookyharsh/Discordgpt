DISCORD_TOKEN=mock_discord_token
DISCORD_CLIENT_ID=mock_client_id
DATABASE_URL=postgresql+asyncpg://postgres:postgrespassword@localhost:5432/discord_agent
REDIS_URL=redis://localhost:6379/0
NEEDLE_CONFIDENCE_THRESHOLD=0.5
AI_PROVIDER=needle
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FALLBACK_TO_NEEDLE=true
OPENROUTER_STRICT_TOOLS=false
PORT=8000
LOG_LEVEL=INFO
ENV=development


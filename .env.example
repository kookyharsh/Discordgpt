DISCORD_TOKEN="your_discord_bot_token"
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# LLM Provider configuration: "gemini" | "openrouter" | "openai"
LLM_PROVIDER="openrouter"

# Gemini Options (if LLM_PROVIDER="gemini")
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-3.6-flash"

# OpenRouter Options (if LLM_PROVIDER="openrouter")
OPENROUTER_API_KEY="your_openrouter_api_key"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# OpenAI / OpenAI-compatible Options (if LLM_PROVIDER="openai")
OPENAI_API_KEY="your_openai_api_key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/discord_agent?schema=public"
# Direct (non-pooled) connection, port 5432. REQUIRED for `prisma migrate dev`.
# Supabase Dashboard -> Project Settings -> Database -> Connection string -> Direct connection.
# Runtime uses DATABASE_URL (pooler, 6543 + ?pgbouncer=true), migrations use DIRECT_URL.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/discord_agent?schema=public"
REDIS_URL="redis://localhost:6379"
PORT=3000
LOG_LEVEL="info"
NODE_ENV="development"
